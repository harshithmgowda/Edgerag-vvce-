# ==============================================================================
# EdgeRAG Unified Environment Configuration Template
# Copy this file to .env and replace placeholder values with your actual settings.
# ==============================================================================

# --- Server Host & Networking ---
EDGERAG_HOST=0.0.0.0
EDGERAG_PORT=8000
EDGERAG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000

# --- Security & JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EDGERAG_SECRET_KEY=change_me_to_a_secure_random_64_character_hex_string_329482
EDGERAG_JWT_ALGORITHM=HS256
EDGERAG_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- MySQL Database (No Docker / Local) ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://edgerag_user:edgerag_password@127.0.0.1:3306/edgerag_db
# Or SQLite fallback for zero-dependency development:
# DATABASE_URL=sqlite:///./edgerag_dev.db

# --- Redis & Celery Worker ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# --- MinIO Object Storage (No Docker / Local) ---
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_MANUALS=edgerag-manuals
MINIO_BUCKET_PACKAGES=edgerag-packages
# Local storage fallback directory if MinIO is not running
LOCAL_STORAGE_DIR=./storage

# --- AI Embeddings & Models ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MAX_CHUNK_TOKENS=224
CHUNK_OVERLAP_TOKENS=32

# --- External Cloud AI Providers ---
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Optional external keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="EdgeRAG HQ"
